function range_loop() -> ret {
  let v0 := 1
  let v1 := 5
  for { } lt(v1, 10) { } {
    v0 := add(v0, v1)
    v1 := add(v1, 1)
  }
  ret := v0
}
function array_loop(arr) -> ret {
  let v0 := 0
  let v1 := 0
  for { } lt(v1, 3) { } {
    let v2 := mload(add(arr, mul(v1, 32)))
    v0 := add(v0, v2)
    v1 := add(v1, 1)
  }
  ret := v0
}
